generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StudentStatus {
  APPLICANT
  ACTIVE
  WITHDRAWN
  GRADUATED
  ARCHIVED
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  LEFT
  ARCHIVED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  NOT_STATED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ASSESSMENT
  INTERVIEW
  OFFERED
  WAITLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  ENROLLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  AUTHORISED_ABSENCE
  UNAUTHORISED_ABSENCE
  MEDICAL
  OTHER
}

enum RegisterStatus {
  OPEN
  SUBMITTED
}

enum AssessmentResultStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BehaviourEventType {
  POSITIVE
  INCIDENT
}

enum BehaviourEventStatus {
  OPEN
  RESOLVED
  ESCALATED
}

enum BehaviourRewardStatus {
  AWARDED
  REVOKED
}

enum BehaviourSanctionType {
  DETENTION
  INTERNAL_EXCLUSION
  SUSPENSION
  COMMUNITY_SERVICE
  REPORT_CARD
  OTHER
}

enum BehaviourSanctionStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CoverStatus {
  PENDING
  CONFIRMED
}

enum ReportType {
  ACADEMIC
  ATTENDANCE
  BEHAVIOUR
  STUDENT
  EXAM
  OTHER
}

enum ReportStatus {
  COMPLETED
  FAILED
}

enum CommunicationThreadType {
  DIRECT
  GROUP
}

enum CommunicationChannel {
  PORTAL
  EMAIL
  WHATSAPP
}

enum CommunicationMessageStatus {
  DRAFT
  SENT
  DELIVERED
  QUEUED
  FAILED
}

enum CommunicationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum CommunicationParticipantType {
  STUDENT
  GUARDIAN
  STAFF
  USER
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  status                  UserStatus               @default(ACTIVE)
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime                 @default(now())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  archivedAt              DateTime?
  roles                   UserRole[]
  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  student                 Student?
  guardian                ParentGuardian?
  staff                   Staff?
  auditEvents             AuditEvent[]             @relation("AuditActor")
  admissionWorkflowEvents AdmissionWorkflowEvent[] @relation("AdmissionWorkflowActor")
  generatedReports        GeneratedReport[]
  communicationThreads    CommunicationThread[] @relation("CommunicationThreadCreator")
  communicationMessages   CommunicationMessage[] @relation("CommunicationMessageSender")
  announcements           Announcement[] @relation("AnnouncementCreator")

  @@index([status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Student {
  id                   String                   @id @default(uuid()) @db.Uuid
  admissionNumber      String                   @unique
  userId               String?                  @unique @db.Uuid
  firstName            String
  middleName           String?
  lastName             String
  preferredName        String?
  dateOfBirth          DateTime
  gender               Gender                   @default(NOT_STATED)
  nationality          String?
  title                String?
  email                String?
  phone                String?
  addressLine1         String?
  addressLine2         String?
  townCity             String?
  postcode             String?
  photoUrl             String?
  status               StudentStatus            @default(ACTIVE)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  archivedAt           DateTime?
  user                 User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians            StudentGuardian[]
  enrollments          Enrollment[]
  staffAssignments     StaffStudentAssignment[]
  admissionApplication AdmissionApplication?
  attendanceRecords    AttendanceRecord[]
  assessmentResults    AssessmentResult[]
  behaviourEvents      BehaviourEvent[]
  behaviourRewards     BehaviourReward[]
  behaviourSanctions   BehaviourSanction[]

  @@index([lastName, firstName])
  @@index([status])
}

model AdmissionApplication {
  id                String                   @id @default(uuid()) @db.Uuid
  applicationNumber String                   @unique
  accessTokenHash   String
  status            AdmissionStatus          @default(DRAFT)
  currentStep       Int                      @default(1)
  email             String
  phone             String?
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  entryYearGroup    String?
  entryAcademicYear String                   @default("2026/2027")
  source            String                   @default("School Website")
  formVersion       Int                      @default(1)
  formData          Json
  studentId         String?                  @unique @db.Uuid
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  student           Student?                 @relation(fields: [studentId], references: [id], onDelete: SetNull)
  documents         AdmissionDocument[]
  workflowEvents    AdmissionWorkflowEvent[]

  @@index([email, dateOfBirth])
  @@index([status, createdAt])
  @@index([entryAcademicYear, entryYearGroup])
}

model AdmissionWorkflowEvent {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @db.Uuid
  actorUserId   String?              @db.Uuid
  fromStatus    AdmissionStatus?
  toStatus      AdmissionStatus
  note          String?
  metadata      Json?
  createdAt     DateTime             @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?                @relation("AdmissionWorkflowActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([toStatus, createdAt])
}

model AdmissionDocument {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @db.Uuid
  category      String
  originalName  String
  storedName    String               @unique
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime             @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, category])
}

model ParentGuardian {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String?           @unique @db.Uuid
  firstName  String
  lastName   String
  email      String?
  phone      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  archivedAt DateTime?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students   StudentGuardian[]

  @@index([email])
}

model StudentGuardian {
  studentId                 String         @db.Uuid
  guardianId                String         @db.Uuid
  relationship              String
  isPrimaryContact          Boolean        @default(false)
  hasPortalAccess           Boolean        @default(true)
  hasParentalResponsibility Boolean        @default(false)
  collectionAuthorized      Boolean        @default(false)
  accessRestrictionNote     String?
  student                   Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian                  ParentGuardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([studentId, guardianId])
  @@index([guardianId, hasPortalAccess])
}

model Staff {
  id                  String                   @id @default(uuid()) @db.Uuid
  staffNumber         String                   @unique
  userId              String?                  @unique @db.Uuid
  firstName           String
  lastName            String
  jobTitle            String
  department          String?
  departmentId        String?                  @db.Uuid
  status              StaffStatus              @default(ACTIVE)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  archivedAt          DateTime?
  user                User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentAssignments  StaffStudentAssignment[]
  timetableSlots      TimetableSlot[]
  formGroups          FormGroup[]
  coverAbsences       CoverArrangement[]       @relation("AbsentStaff")
  coverAssignments    CoverArrangement[]       @relation("CoverStaff")
  attendanceRegisters AttendanceRegister[]
  academicDepartment  Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teachingAssignments TeachingAssignment[]
  behaviourEvents     BehaviourEvent[]
  behaviourRewards    BehaviourReward[]
  behaviourSanctions  BehaviourSanction[]

  @@index([departmentId])
}

model AcademicYear {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @unique
  startsOn            DateTime
  endsOn              DateTime
  isCurrent           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  terms               Term[]
  enrollments         Enrollment[]
  enquiries           AdmissionEnquiry[]
  curriculumSubjects  CurriculumSubject[]
  curricula           Curriculum[]
  teachingAssignments TeachingAssignment[]
  generatedReports     GeneratedReport[]
}

model Term {
  id                  String               @id @default(uuid()) @db.Uuid
  academicYearId      String               @db.Uuid
  name                String
  startsOn            DateTime
  endsOn              DateTime
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  attendanceRegisters AttendanceRegister[]
  assessments         Assessment[]
  behaviourEvents     BehaviourEvent[]
  behaviourRewards    BehaviourReward[]
  behaviourSanctions  BehaviourSanction[]
  timetableSlots      TimetableSlot[]
  generatedReports    GeneratedReport[]

  @@unique([academicYearId, name])
  @@index([startsOn, endsOn])
}

model YearGroup {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  name                String
  displayOrder        Int
  enrollments         Enrollment[]
  attendanceRegisters AttendanceRegister[]
  assessments         Assessment[]
  timetableSlots      TimetableSlot[]
  formGroups          FormGroup[]
  curriculumSubjects  CurriculumSubject[]
  curricula           Curriculum[]
}

model Department {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  name                String               @unique
  description         String?
  isActive            Boolean              @default(true)
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subjects            Subject[]
  staff               Staff[]
  formGroups          FormGroup[]
  teachingAssignments TeachingAssignment[]
}

model Curriculum {
  id             String              @id @default(uuid()) @db.Uuid
  code           String
  name           String
  description    String?
  academicYearId String              @db.Uuid
  yearGroupId    String?             @db.Uuid
  isActive       Boolean             @default(true)
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  yearGroup      YearGroup?          @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  subjects       CurriculumSubject[]
  formGroups     FormGroup[]

  @@unique([academicYearId, code])
  @@index([academicYearId, isActive])
  @@index([yearGroupId])
}

model FormGroup {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  name                String
  yearGroupId         String               @db.Uuid
  tutorStaffId        String?              @db.Uuid
  curriculumId        String?              @db.Uuid
  departmentId        String?              @db.Uuid
  isActive            Boolean              @default(true)
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  yearGroup           YearGroup            @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  tutor               Staff?               @relation(fields: [tutorStaffId], references: [id], onDelete: SetNull)
  curriculum          Curriculum?          @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  enrollments         Enrollment[]
  timetableSlots      TimetableSlot[]
  attendanceRegisters AttendanceRegister[]
  teachingAssignments TeachingAssignment[]
  behaviourEvents     BehaviourEvent[]

  @@index([yearGroupId, isActive])
  @@index([tutorStaffId])
  @@index([curriculumId])
  @@index([departmentId])
}

model House {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
}

model Subject {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  name                String
  department          String?
  departmentId        String?              @db.Uuid
  isActive            Boolean              @default(true)
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  timetableSlots      TimetableSlot[]
  assessments         Assessment[]
  curriculumSubjects  CurriculumSubject[]
  academicDepartment  Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teachingAssignments TeachingAssignment[]

  @@index([departmentId])
}

model CurriculumSubject {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @db.Uuid
  yearGroupId    String       @db.Uuid
  subjectId      String       @db.Uuid
  curriculumId   String?      @db.Uuid
  weeklyPeriods  Int          @default(4)
  isActive       Boolean      @default(true)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  yearGroup      YearGroup    @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  curriculum     Curriculum?  @relation(fields: [curriculumId], references: [id], onDelete: SetNull)

  @@unique([academicYearId, yearGroupId, subjectId])
  @@index([yearGroupId, subjectId])
  @@index([curriculumId])
}

model TeachingAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @db.Uuid
  formGroupId    String       @db.Uuid
  subjectId      String       @db.Uuid
  staffId        String       @db.Uuid
  departmentId   String?      @db.Uuid
  isActive       Boolean      @default(true)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  formGroup      FormGroup    @relation(fields: [formGroupId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([academicYearId, formGroupId, subjectId])
  @@index([staffId, isActive])
  @@index([departmentId])
}

model Enrollment {
  id             String       @id @default(uuid()) @db.Uuid
  studentId      String       @db.Uuid
  academicYearId String       @db.Uuid
  yearGroupId    String       @db.Uuid
  formGroupId    String?      @db.Uuid
  houseId        String?      @db.Uuid
  startsOn       DateTime
  endsOn         DateTime?
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  yearGroup      YearGroup    @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  formGroup      FormGroup?   @relation(fields: [formGroupId], references: [id], onDelete: Restrict)
  house          House?       @relation(fields: [houseId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([academicYearId, yearGroupId])
  @@index([formGroupId])
  @@index([houseId])
}

model StaffStudentAssignment {
  staffId   String    @db.Uuid
  studentId String    @db.Uuid
  scope     String
  startsOn  DateTime
  endsOn    DateTime?
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([staffId, studentId, scope, startsOn])
  @@index([studentId, startsOn, endsOn])
}

model AdmissionEnquiry {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @db.Uuid
  firstName      String
  lastName       String
  email          String?
  source         String
  createdAt      DateTime     @default(now())
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@index([academicYearId, createdAt])
  @@index([source, createdAt])
}

model AttendanceRegister {
  id              String             @id @default(uuid()) @db.Uuid
  termId          String             @db.Uuid
  yearGroupId     String             @db.Uuid
  formGroupId     String?            @db.Uuid
  timetableSlotId String?            @db.Uuid
  teacherId       String?            @db.Uuid
  date            DateTime           @db.Date
  periodLabel     String
  registerType    String             @default("LESSON")
  status          RegisterStatus     @default(OPEN)
  submittedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  term            Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  yearGroup       YearGroup          @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  formGroup       FormGroup?         @relation(fields: [formGroupId], references: [id], onDelete: SetNull)
  timetableSlot   TimetableSlot?     @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  teacher         Staff?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  records         AttendanceRecord[]

  @@unique([termId, yearGroupId, formGroupId, date, periodLabel])
  @@index([date, status])
  @@index([timetableSlotId, date])
  @@index([teacherId, date])
}

model AttendanceRecord {
  id         String             @id @default(uuid()) @db.Uuid
  registerId String             @db.Uuid
  studentId  String             @db.Uuid
  status     AttendanceStatus
  note       String?
  markedAt   DateTime           @default(now())
  recordedAt DateTime           @default(now())
  register   AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([registerId, studentId])
  @@index([studentId, recordedAt])
  @@index([status, recordedAt])
}

model Assessment {
  id          String             @id @default(uuid()) @db.Uuid
  termId      String             @db.Uuid
  yearGroupId String             @db.Uuid
  subjectId   String?            @db.Uuid
  title       String
  dueAt       DateTime
  isActive    Boolean            @default(true)
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  term        Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  yearGroup   YearGroup          @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  subject     Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  results     AssessmentResult[]

  @@index([termId, dueAt])
  @@index([yearGroupId, dueAt])
  @@index([subjectId])
}

model AssessmentResult {
  id            String                 @id @default(uuid()) @db.Uuid
  assessmentId  String                 @db.Uuid
  studentId     String                 @db.Uuid
  status        AssessmentResultStatus @default(NOT_STARTED)
  attainmentPct Float?
  progressPct   Float?
  updatedAt     DateTime               @updatedAt
  assessment    Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student       Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, studentId])
  @@index([studentId, status])
}

model BehaviourCategory {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  name          String
  type          BehaviourEventType
  defaultPoints Int
  description   String?
  isActive      Boolean            @default(true)
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  events        BehaviourEvent[]

  @@index([type, isActive])
}

model BehaviourEvent {
  id          String               @id @default(uuid()) @db.Uuid
  studentId   String               @db.Uuid
  termId      String               @db.Uuid
  categoryId  String?              @db.Uuid
  staffId     String?              @db.Uuid
  formGroupId String?              @db.Uuid
  type        BehaviourEventType
  status      BehaviourEventStatus @default(OPEN)
  summary     String
  details     String?
  location    String?
  points      Int                  @default(0)
  occurredAt  DateTime
  resolvedAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  student     Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term        Term                 @relation(fields: [termId], references: [id], onDelete: Restrict)
  category    BehaviourCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff       Staff?               @relation(fields: [staffId], references: [id], onDelete: SetNull)
  formGroup   FormGroup?           @relation(fields: [formGroupId], references: [id], onDelete: SetNull)
  sanctions   BehaviourSanction[]

  @@index([termId, occurredAt])
  @@index([type, status, archivedAt])
  @@index([studentId, occurredAt])
  @@index([categoryId])
  @@index([staffId])
}

model BehaviourReward {
  id          String                @id @default(uuid()) @db.Uuid
  studentId   String                @db.Uuid
  termId      String                @db.Uuid
  staffId     String?               @db.Uuid
  title       String
  description String?
  points      Int                   @default(0)
  status      BehaviourRewardStatus @default(AWARDED)
  awardedAt   DateTime
  archivedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  student     Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term        Term                  @relation(fields: [termId], references: [id], onDelete: Restrict)
  staff       Staff?                @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([termId, awardedAt])
  @@index([studentId, archivedAt])
}

model BehaviourSanction {
  id               String                  @id @default(uuid()) @db.Uuid
  studentId        String                  @db.Uuid
  termId           String                  @db.Uuid
  staffId          String?                 @db.Uuid
  behaviourEventId String?                 @db.Uuid
  type             BehaviourSanctionType
  status           BehaviourSanctionStatus @default(PENDING)
  title            String
  description      String?
  scheduledFor     DateTime?
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  student          Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term             Term                    @relation(fields: [termId], references: [id], onDelete: Restrict)
  staff            Staff?                  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  behaviourEvent   BehaviourEvent?         @relation(fields: [behaviourEventId], references: [id], onDelete: SetNull)

  @@index([termId, status, scheduledFor])
  @@index([studentId, archivedAt])
  @@index([behaviourEventId])
}

model TimetableSlot {
  id                  String               @id @default(uuid()) @db.Uuid
  termId              String               @db.Uuid
  yearGroupId         String               @db.Uuid
  formGroupId         String?              @db.Uuid
  subjectId           String               @db.Uuid
  staffId             String?              @db.Uuid
  weekday             Int
  startsAt            String
  endsAt              String
  periodLabel         String
  room                String?
  term                Term                 @relation(fields: [termId], references: [id], onDelete: Restrict)
  yearGroup           YearGroup            @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  formGroup           FormGroup?           @relation(fields: [formGroupId], references: [id], onDelete: SetNull)
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  staff               Staff?               @relation(fields: [staffId], references: [id], onDelete: SetNull)
  coverArrangements   CoverArrangement[]
  attendanceRegisters AttendanceRegister[]

  @@index([termId, weekday, startsAt])
  @@index([formGroupId])
}

model CoverArrangement {
  id              String        @id @default(uuid()) @db.Uuid
  timetableSlotId String        @db.Uuid
  absentStaffId   String        @db.Uuid
  coverStaffId    String?       @db.Uuid
  date            DateTime      @db.Date
  status          CoverStatus   @default(PENDING)
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  timetableSlot   TimetableSlot @relation(fields: [timetableSlotId], references: [id], onDelete: Restrict)
  absentStaff     Staff         @relation("AbsentStaff", fields: [absentStaffId], references: [id], onDelete: Restrict)
  coverStaff      Staff?        @relation("CoverStaff", fields: [coverStaffId], references: [id], onDelete: SetNull)

  @@unique([timetableSlotId, date])
  @@index([date, status])
  @@index([absentStaffId])
  @@index([coverStaffId])
}

model AuditEvent {
  id          String       @id @default(uuid()) @db.Uuid
  actorUserId String?      @db.Uuid
  action      String
  entityType  String
  entityId    String?
  outcome     AuditOutcome @default(SUCCESS)
  requestId   String
  ipAddress   String?
  userAgent   String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime     @default(now())
  actor       User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model GeneratedReport {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  type           ReportType
  status         ReportStatus @default(COMPLETED)
  academicYearId String       @db.Uuid
  termId         String?      @db.Uuid
  generatedById  String       @db.Uuid
  filters        Json?
  snapshot       Json
  generatedAt    DateTime     @default(now())
  archivedAt     DateTime?
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term           Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  generatedBy    User         @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([academicYearId, type, generatedAt])
  @@index([generatedById, generatedAt])
  @@index([archivedAt])
}

model CommunicationThread {
  id            String                    @id @default(uuid()) @db.Uuid
  subject       String
  type          CommunicationThreadType   @default(DIRECT)
  channel       CommunicationChannel      @default(PORTAL)
  createdById   String                    @db.Uuid
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  archivedAt    DateTime?
  createdBy     User                      @relation("CommunicationThreadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants  CommunicationParticipant[]
  messages      CommunicationMessage[]

  @@index([lastMessageAt, archivedAt])
  @@index([createdById, createdAt])
}

model CommunicationParticipant {
  id          String                       @id @default(uuid()) @db.Uuid
  threadId    String                       @db.Uuid
  type        CommunicationParticipantType
  entityId    String                       @db.Uuid
  displayName String
  roleLabel   String
  email       String?
  phone       String?
  readAt      DateTime?
  createdAt   DateTime                     @default(now())
  thread      CommunicationThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  deliveries CommunicationDelivery[]
  sentMessages CommunicationMessage[]       @relation("CommunicationParticipantSender")

  @@unique([threadId, type, entityId])
  @@index([type, entityId])
}

model CommunicationMessage {
  id           String                     @id @default(uuid()) @db.Uuid
  threadId     String                     @db.Uuid
  senderUserId String?                    @db.Uuid
  senderParticipantId String?             @db.Uuid
  body         String
  status       CommunicationMessageStatus @default(SENT)
  assisted     Boolean                    @default(false)
  sentAt       DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  archivedAt   DateTime?
  thread       CommunicationThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User?                      @relation("CommunicationMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  senderParticipant CommunicationParticipant? @relation("CommunicationParticipantSender", fields: [senderParticipantId], references: [id], onDelete: SetNull)
  deliveries   CommunicationDelivery[]

  @@index([threadId, createdAt])
  @@index([status, createdAt])
  @@index([senderUserId, createdAt])
  @@index([senderParticipantId, createdAt])
}

model CommunicationDelivery {
  id            String                      @id @default(uuid()) @db.Uuid
  messageId     String                      @db.Uuid
  participantId String                      @db.Uuid
  channel       CommunicationChannel
  destination   String
  status        CommunicationDeliveryStatus @default(QUEUED)
  provider      String
  providerId    String?
  errorCode     String?
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  message       CommunicationMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant   CommunicationParticipant    @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
  @@index([provider, providerId])
  @@index([status, createdAt])
}

model Announcement {
  id            String             @id @default(uuid()) @db.Uuid
  title         String
  body          String
  audience      Json
  audienceLabel String
  priority      String             @default("NORMAL")
  status        AnnouncementStatus @default(DRAFT)
  publishAt     DateTime?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdById   String             @db.Uuid
  assisted      Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  archivedAt    DateTime?
  createdBy     User               @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, publishedAt, archivedAt])
  @@index([createdById, createdAt])
}

model ImportJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  status      String
  sourceName  String
  totalRows   Int       @default(0)
  validRows   Int       @default(0)
  invalidRows Int       @default(0)
  report      Json?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdById, createdAt])
}
